# Maintainer: Jerónimo Albi <jeronimoalbi@gmail.com>
#
# Builds Morlaco from this repository's COMMITTED state, so commit before
# running makepkg: uncommitted changes are not part of the package.
#
#   cd packaging/arch && makepkg -f
#   sudo pacman -U morlaco-*.pkg.tar.zst

pkgname=morlaco
pkgver=0.1.0
pkgrel=1
pkgdesc='GNOME app that tracks wallet holdings and unrealized gains'
arch=('x86_64')
# Placeholder: the repository does not contain a license yet.
license=('custom')
depends=('glib2' 'gtk4' 'libadwaita' 'libsecret' 'openssl')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=('gnome-keyring: keeps the key that encrypts your data')
# The bundled SQLCipher is C code; link-time optimization from makepkg's
# default flags can break it. No separate -debug package: the build carries
# no debug information worth shipping, and one file keeps `pacman -U` simple.
options=('!lto' '!debug')
source=("$pkgname::git+file://$(git rev-parse --show-toplevel)")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p morlaco
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" PREFIX=/usr ./install.sh --no-build
}
